{
  "name": "zennovel",
  "private": true,
  "version": "0.1.0",
  "description": "A web-based, low-code visual novel maker for writers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @zennovel/editor dev",
    "build": "pnpm --filter @zennovel/editor build",
    "preview": "pnpm --filter @zennovel/editor preview",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "pnpm --filter @zennovel/desktop start",
    "desktop:dev": "pnpm --filter @zennovel/desktop dev",
    "desktop:dist": "pnpm --filter @zennovel/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
