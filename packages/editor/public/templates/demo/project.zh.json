{
  "formatVersion": 1,
  "meta": {
    "id": "proj_demo",
    "name": "樱花坡道（示例）",
    "author": "ZenNovel",
    "description": "一个三分钟的小故事，演示背景、角色、选项、变量和多结局。",
    "resolution": {
      "width": 1280,
      "height": 720
    },
    "createdAt": "2026-10-05T00:00:00.000Z",
    "updatedAt": "2026-10-05T00:00:00.000Z",
    "locale": "zh"
  },
  "assets": [
    {
      "id": "img_park",
      "kind": "image",
      "name": "公园",
      "src": "assets/bg_park.svg"
    },
    {
      "id": "img_library",
      "kind": "image",
      "name": "图书馆",
      "src": "assets/bg_library.svg"
    },
    {
      "id": "img_rooftop",
      "kind": "image",
      "name": "天台",
      "src": "assets/bg_rooftop.svg"
    },
    {
      "id": "img_mei",
      "kind": "image",
      "name": "小梅",
      "src": "assets/mei.svg"
    },
    {
      "id": "img_theo",
      "kind": "image",
      "name": "阿哲",
      "src": "assets/theo.svg"
    }
  ],
  "characters": [
    {
      "id": "chr_mei",
      "name": "小梅",
      "color": "#c8553d",
      "sprites": {
        "normal": "img_mei"
      }
    },
    {
      "id": "chr_theo",
      "name": "阿哲",
      "color": "#3f6e8c",
      "sprites": {
        "normal": "img_theo"
      }
    }
  ],
  "variables": [
    {
      "id": "var_courage",
      "name": "勇气",
      "initial": 0
    }
  ],
  "theme": {
    "fontFamily": "\"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans SC\", system-ui, sans-serif",
    "textSpeed": 40,
    "dialogue": {
      "background": "rgba(20, 22, 35, 0.82)",
      "textColor": "#f4f1ea",
      "fontSize": 26,
      "borderRadius": 14,
      "padding": 28,
      "height": 0.28,
      "margin": 24
    },
    "nameplate": {
      "background": "#c8553d",
      "textColor": "#ffffff",
      "fontSize": 22
    },
    "choice": {
      "background": "rgba(20, 22, 35, 0.85)",
      "hoverBackground": "rgba(200, 85, 61, 0.95)",
      "textColor": "#f4f1ea",
      "borderRadius": 10
    }
  },
  "startSceneId": "scene_start",
  "scenes": [
    {
      "id": "scene_start",
      "name": "放学后的坡道",
      "position": {
        "x": 0,
        "y": 120
      },
      "commands": [
        {
          "id": "cmd_001",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "img_park"
          },
          "transition": "fade"
        },
        {
          "id": "cmd_002",
          "type": "say",
          "text": "四月，樱花铺满了回家的坡道。"
        },
        {
          "id": "cmd_003",
          "type": "show",
          "characterId": "chr_mei",
          "expression": "normal",
          "position": "center"
        },
        {
          "id": "cmd_004",
          "type": "say",
          "characterId": "chr_mei",
          "text": "你今天也一个人回家吗？"
        },
        {
          "id": "cmd_005",
          "type": "say",
          "characterId": "chr_mei",
          "text": "要不要……一起去哪里走走？"
        },
        {
          "id": "cmd_006",
          "type": "choice",
          "prompt": "去哪里呢？",
          "options": [
            {
              "id": "opt_library",
              "text": "去图书馆还书",
              "effects": [
                {
                  "variableId": "var_courage",
                  "op": "add",
                  "value": 1
                }
              ],
              "targetSceneId": "scene_library"
            },
            {
              "id": "opt_rooftop",
              "text": "去天台看夕阳",
              "targetSceneId": "scene_rooftop"
            }
          ]
        }
      ]
    },
    {
      "id": "scene_library",
      "name": "图书馆",
      "position": {
        "x": 320,
        "y": 0
      },
      "commands": [
        {
          "id": "cmd_007",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "img_library"
          },
          "transition": "fade"
        },
        {
          "id": "cmd_008",
          "type": "show",
          "characterId": "chr_mei",
          "expression": "normal",
          "position": "left"
        },
        {
          "id": "cmd_009",
          "type": "say",
          "text": "图书馆里很安静，只听得见翻书的声音。"
        },
        {
          "id": "cmd_010",
          "type": "say",
          "characterId": "chr_mei",
          "text": "其实……我一直想跟你说声谢谢。"
        },
        {
          "id": "cmd_011",
          "type": "jump",
          "targetSceneId": "scene_ending"
        }
      ]
    },
    {
      "id": "scene_rooftop",
      "name": "天台",
      "position": {
        "x": 320,
        "y": 240
      },
      "commands": [
        {
          "id": "cmd_012",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "img_rooftop"
          },
          "transition": "fade"
        },
        {
          "id": "cmd_013",
          "type": "show",
          "characterId": "chr_mei",
          "expression": "normal",
          "position": "left"
        },
        {
          "id": "cmd_014",
          "type": "show",
          "characterId": "chr_theo",
          "expression": "normal",
          "position": "right"
        },
        {
          "id": "cmd_015",
          "type": "say",
          "characterId": "chr_theo",
          "text": "哟，你们也来看夕阳？"
        },
        {
          "id": "cmd_016",
          "type": "choice",
          "options": [
            {
              "id": "opt_stay",
              "text": "「一起看吧。」",
              "effects": [
                {
                  "variableId": "var_courage",
                  "op": "add",
                  "value": 1
                }
              ]
            },
            {
              "id": "opt_quiet",
              "text": "（什么也没说）"
            }
          ]
        },
        {
          "id": "cmd_017",
          "type": "say",
          "text": "三个人并排站着，谁都没有再说话。"
        },
        {
          "id": "cmd_018",
          "type": "hide",
          "characterId": "chr_theo"
        },
        {
          "id": "cmd_019",
          "type": "jump",
          "targetSceneId": "scene_ending"
        }
      ]
    },
    {
      "id": "scene_ending",
      "name": "结局",
      "position": {
        "x": 640,
        "y": 120
      },
      "commands": [
        {
          "id": "cmd_020",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "img_park"
          },
          "transition": "fade"
        },
        {
          "id": "cmd_021",
          "type": "show",
          "characterId": "chr_mei",
          "expression": "normal",
          "position": "center"
        },
        {
          "id": "cmd_026",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "var_courage",
            "op": ">=",
            "value": 1
          },
          "then": [
            {
              "id": "cmd_022",
              "type": "say",
              "characterId": "chr_mei",
              "text": "明天……也一起走吧？"
            },
            {
              "id": "cmd_023",
              "type": "say",
              "text": "【好结局】樱花还会再开很多次。"
            }
          ],
          "else": [
            {
              "id": "cmd_024",
              "type": "say",
              "characterId": "chr_mei",
              "text": "那，明天见。"
            },
            {
              "id": "cmd_025",
              "type": "say",
              "text": "【普通结局】坡道上只剩下风声。"
            }
          ]
        },
        {
          "id": "cmd_027",
          "type": "end"
        }
      ]
    }
  ]
}
