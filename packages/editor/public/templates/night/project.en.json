  "scenes": [
    {
      "id": "day",
      "name": "Day",
      "position": {
        "x": 0,
        "y": 0
      },
      "commands": [
        {
          "id": "c0001",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_day"
          }
        },
        {
          "id": "c0002",
          "type": "music",
          "action": "play",
          "assetId": "snd_day",
          "loop": true,
          "volume": 0.5
        },
        {
          "id": "c0003",
          "type": "say",
          "characterId": "qin",
          "text": "You're the new one? I'm Qin. The night shift on this street is mine."
        },
        {
          "id": "c0004",
          "type": "say",
          "characterId": "qin",
          "text": "By day this street looks peaceful. After dark, half the lamps are out and the cars drive faster than they do in daylight."
        },
        {
          "id": "c0005",
          "type": "say",
          "characterId": "qin",
          "text": "You've got one job: once it's dark, everyone who comes through here gets across safely."
        },
        {
          "id": "c0006",
          "type": "say",
          "characterId": "qin",
          "text": "Tools are in the locker. Take one."
        },
        {
          "id": "c0007",
          "type": "choice",
          "options": [
            {
              "id": "c0008",
              "text": "The big torch: reaches far, very bright, eats batteries.",
              "effects": [
                {
                  "variableId": "tool",
                  "op": "set",
                  "value": 1
                }
              ]
            },
            {
              "id": "c0009",
              "text": "The old torch: a smaller circle of light, but it lasts the whole night.",
              "effects": [
                {
                  "variableId": "tool",
                  "op": "set",
                  "value": 2
                }
              ]
            }
          ],
          "prompt": "What do you take out on the street?"
        },
        {
          "id": "c0010",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "tool",
            "op": "==",
            "value": 1
          },
          "then": [
            {
              "id": "c0011",
              "type": "say",
              "characterId": "qin",
              "text": "The big one? Fine. Go easy on it. Nobody's bringing you batteries out there."
            }
          ],
          "else": [
            {
              "id": "c0012",
              "type": "say",
              "characterId": "qin",
              "text": "That one's been with me ten-odd years. Small light, but you can count on it."
            }
          ]
        },
        {
          "id": "c0013",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_dusk"
          },
          "transition": "fade"
        },
        {
          "id": "c0014",
          "type": "say",
          "characterId": "qin",
          "text": "It's getting dark. Remember: drivers only see what your light is on."
        },
        {
          "id": "c0015",
          "type": "say",
          "characterId": "qin",
          "text": "Your hand (the mouse) is the torch. When you see someone, keep the light steady on them."
        },
