            {
              "id": "c0084",
              "type": "say",
              "characterId": "qin",
              "text": "The driver says he never saw anyone in the road."
            },
            {
              "id": "c0085",
              "type": "say",
              "characterId": "qin",
              "text": "Where your light doesn't reach, as far as a driver's concerned, there's nobody there. Remember that."
            },
            {
              "id": "c0086",
              "type": "say",
              "text": "[End of the prototype. Try again: keep the light on her until the car gets there.]"
