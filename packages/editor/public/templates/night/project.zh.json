  "scenes": [
    {
      "id": "day",
      "name": "白天",
      "position": {
        "x": 0,
        "y": 0
      },
      "commands": [
        {
          "id": "c0001",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_day"
          }
        },
        {
          "id": "c0002",
          "type": "music",
          "action": "play",
          "assetId": "snd_day",
          "loop": true,
          "volume": 0.5
        },
        {
          "id": "c0003",
          "type": "say",
          "characterId": "qin",
          "text": "新来的？我姓秦，这条街的夜班归我管。"
        },
        {
          "id": "c0004",
          "type": "say",
          "characterId": "qin",
          "text": "这条街白天看着太平。天一黑，路灯坏一半，车开得比白天还快。"
        },
        {
          "id": "c0005",
          "type": "say",
          "characterId": "qin",
          "text": "你的活儿就一件：天黑以后，让每一个从这儿过的人，都平平安安地走过去。"
        },
        {
          "id": "c0006",
          "type": "say",
          "characterId": "qin",
          "text": "工具在柜子里，挑一样。"
        },
        {
          "id": "c0007",
          "type": "choice",
          "options": [
            {
              "id": "c0008",
              "text": "强光手电：照得远、照得亮，就是费电。",
              "effects": [
                {
                  "variableId": "tool",
                  "op": "set",
                  "value": 1
                }
              ]
            },
            {
              "id": "c0009",
              "text": "老式手电：光圈小一点，电池撑得住一整夜。",
              "effects": [
                {
                  "variableId": "tool",
                  "op": "set",
                  "value": 2
                }
              ]
            }
          ],
          "prompt": "带哪一样上街？"
        },
        {
          "id": "c0010",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "tool",
            "op": "==",
            "value": 1
          },
          "then": [
            {
              "id": "c0011",
              "type": "say",
              "characterId": "qin",
              "text": "强光的？行。省着点用，电没了可没人给你送。"
            }
          ],
          "else": [
            {
              "id": "c0012",
              "type": "say",
              "characterId": "qin",
              "text": "这把跟了我十几年了。光小，可靠得住。"
            }
          ]
        },
        {
          "id": "c0013",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_dusk"
          },
          "transition": "fade"
        },
        {
          "id": "c0014",
          "type": "say",
          "characterId": "qin",
          "text": "天要黑了。记住：光照到哪儿，司机才看得见哪儿。"
        },
        {
          "id": "c0015",
          "type": "say",
          "characterId": "qin",
          "text": "你的手（鼠标）就是手电。看见有人，就把光稳稳地照在他身上。"
        },
