  "scenes": [
    {
      "id": "intro",
      "name": "Prologue",
      "position": {
        "x": 0,
        "y": 0
      },
      "commands": [
        {
          "id": "c0001",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_title"
          }
        },
        {
          "id": "c0002",
          "type": "music",
          "action": "play",
          "assetId": "snd_street",
          "loop": true,
          "volume": 0.5
        },
        {
          "id": "c0003",
          "type": "say",
          "text": "This photograph has been in my drawer for thirty years."
        },
        {
          "id": "c0004",
          "type": "say",
          "text": "It was never printed in any paper."
        },
        {
          "id": "c0005",
          "type": "say",
          "text": "It was taken at twelve minutes past six in the evening. The clock on the corner can vouch for that."
        },
        {
          "id": "c0006",
          "type": "say",
          "text": "Before the shutter clicked, everyone in it still had a few minutes."
        },
        {
          "id": "c0007",
          "type": "sound",
          "assetId": "snd_shutter",
          "volume": 0.9
        },
        {
          "id": "c0008",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_photo"
          },
          "transition": "fade"
        },
        {
          "id": "c0009",
          "type": "show",
          "characterId": "boy",
          "expression": "there",
          "position": "center",
          "place": {
            "x": 0.5,
            "y": 1,
            "height": 1
          }
        },
        {
          "id": "c0010",
          "type": "show",
          "characterId": "post",
          "expression": "riding past",
          "position": "center",
          "place": {
            "x": 0.5,
            "y": 1,
            "height": 1
          }
        },
        {
          "id": "c0011",
          "type": "show",
          "characterId": "girl",
          "expression": "waiting",
          "position": "center",
          "place": {
            "x": 0.5,
            "y": 1,
            "height": 1
          }
        },
        {
          "id": "c0012",
          "type": "show",
          "characterId": "film",
          "expression": "grain",
          "position": "center",
          "place": {
            "x": 0.5,
            "y": 1,
            "height": 1
          }
        },
        {
          "id": "c0013",
          "type": "say",
          "text": "You can step into those minutes, for any one of them."
        },
        {
          "id": "c0014",
          "type": "jump",
          "targetSceneId": "photo"
        }
      ]
    },
