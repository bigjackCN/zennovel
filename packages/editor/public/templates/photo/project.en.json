          }
        },
        {
          "id": "c0138",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "letterGiven",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0139",
              "type": "say",
              "text": "I wrote that letter. I had the post office take it to the clock, because I didn't have the courage to walk over myself."
            }
          ],
          "else": [
            {
              "id": "c0140",
              "type": "say",
              "text": "I wrote a letter and asked the post office to get it to the clock before six. It never arrived."
            }
          ]
        },
        {
          "id": "c0141",
          "type": "say",
          "text": "That evening I was standing across the street, holding a camera, pretending to photograph the street."
        },
        {
          "id": "c0142",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "girlLeft",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0143",
              "type": "say",
              "text": "She left, and she didn't look back. By the time I pressed the shutter she was nearly out of the frame."
            }
          ],
          "else": [
            {
              "id": "c0144",
              "type": "say",
              "text": "She kept waiting. All I had to do was cross the street to be in front of her. I didn't. I just pressed the shutter."
            }
          ]
        },
        {
          "id": "c0145",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "boyStayed",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0146",
              "type": "say",
              "text": "The newspaper boy shouted \"Evening paper!\" inside my viewfinder. It's the only sound I remember from that evening."
            }
          ],
          "else": [
            {
              "id": "c0147",
              "type": "say",
              "text": "All the newspaper boy left behind was one newspaper. I picked it up. The news that day was the same as always."
            }
          ]
        },
        {
          "id": "c0148",
          "type": "say",
          "text": "I never took this photograph to any paper."
        },
        {
          "id": "c0149",
          "type": "say",
          "text": "Everyone in it is still standing in that one second. I'm the only one who walked out of it."
        },
        {
          "id": "c0150",
          "type": "say",
          "text": "[This is the print you developed. Choose \"Save picture\" in the menu to keep it.]"
        },
