    {
      "id": "boy1",
      "name": "Xiaoman",
      "position": {
        "x": 600,
        "y": -220
      },
      "commands": [
        {
          "id": "c0034",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_near_boy"
          },
          "transition": "fade"
        },
        {
          "id": "c0035",
          "type": "hide",
          "characterId": "boy"
        },
        {
          "id": "c0036",
          "type": "hide",
          "characterId": "post"
        },
        {
          "id": "c0037",
          "type": "hide",
          "characterId": "girl"
        },
        {
          "id": "c0038",
          "type": "say",
          "text": "5:40."
        },
        {
          "id": "c0039",
          "type": "say",
          "text": "Xiaoman had twelve evening papers left in his canvas bag."
        },
        {
          "id": "c0040",
          "type": "say",
          "text": "His mother had said: be home before the street lamps come on. The street lamps were on."
        },
        {
          "id": "c0041",
          "type": "say",
          "characterId": "buyer",
          "text": "Anything in the news today, kid?"
        },
        {
          "id": "c0042",
          "type": "say",
          "characterId": "boy",
          "text": "Same as always. Ten fen a copy."
        },
        {
          "id": "c0043",
          "type": "say",
          "text": "The man laughed, gave him twenty, and told him to keep the change. Xiaoman squeezed the coins until his palm was wet."
        },
        {
          "id": "c0044",
          "type": "say",
          "text": "Eleven left. Sell those, and there'd be enough for two doses of his mother's medicine."
        },
        {
          "id": "c0045",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "letterGiven",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0046",
              "type": "say",
              "text": "Across the street, the postman had stopped his bike under the clock and was handing a girl a letter. Who gets their post in the middle of the street, Xiaoman wondered."
            }
          ],
          "else": []
        },
        {
          "id": "c0047",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "girlLeft",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0048",
              "type": "say",
              "text": "The girl in the long coat under the clock had just walked off. She walked fast, as if she didn't see anything."
            }
          ],
          "else": []
        },
        {
          "id": "c0049",
          "type": "say",
          "text": "It was getting darker. The wind lifted the corner of a paper and made it snap."
        },
        {
          "id": "c0050",
          "type": "choice",
          "options": [
            {
              "id": "c0051",
              "text": "Sell a while longer. Eleven left.",
              "effects": [
                {
                  "variableId": "boyStayed",
                  "op": "set",
                  "value": true
                }
              ]
            },
            {
              "id": "c0052",
              "text": "Go home. Mother is waiting.",
              "effects": [
                {
                  "variableId": "boyStayed",
                  "op": "set",
                  "value": false
                }
              ]
            }
          ],
          "prompt": "The street lamps are on."
        },
        {
          "id": "c0053",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "boyStayed",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0054",
              "type": "say",
              "text": "He held a paper high over his head and called out to the crowd going home from work:"
            },
            {
              "id": "c0055",
              "type": "say",
              "characterId": "boy",
              "text": "Evening paper! Evening paper!"
            },
            {
              "id": "c0056",
              "type": "say",
              "text": "In the photograph his mouth is open. Whatever he is calling, nobody who looks at it can hear."
            }
          ],
          "else": [
            {
              "id": "c0057",
              "type": "say",
              "text": "He swung the bag onto his back and ran. As he ran past the corner, a paper slid out of the bag onto the wet ground."
            },
            {
              "id": "c0058",
              "type": "say",
              "text": "He didn't look back. That night his mother asked if he'd sold well. He said yes."
            },
            {
              "id": "c0059",
              "type": "say",
              "text": "In the photograph, all that's left where he stood is that one newspaper."
            }
          ]
        },
        {
          "id": "c0060",
          "type": "setVar",
          "effect": {
            "variableId": "seenBoy",
            "op": "set",
            "value": true
          }
        },
        {
          "id": "c0061",
          "type": "jump",
          "targetSceneId": "photo"
        }
      ]
    },
    {
      "id": "post1",
      "name": "Old Zhou",
      "position": {
        "x": 600,
        "y": 0
      },
      "commands": [
        {
          "id": "c0062",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_near_post"
          },
          "transition": "fade"
        },
        {
          "id": "c0063",
          "type": "hide",
          "characterId": "boy"
        },
        {
          "id": "c0064",
          "type": "hide",
          "characterId": "post"
        },
        {
          "id": "c0065",
          "type": "hide",
          "characterId": "girl"
        },
        {
          "id": "c0066",
          "type": "say",
          "text": "5:50."
        },
        {
          "id": "c0067",
          "type": "say",
          "text": "There was one letter left in Old Zhou's bag."
        },
        {
          "id": "c0068",
          "type": "say",
          "text": "No house number on the envelope. Just: This street. Under the clock. For Lin Xiu."
        },
        {
          "id": "c0069",
          "type": "say",
          "text": "And on the back, in small writing: She'll be waiting under the clock at six. Please give it to her before six."
        },
        {
          "id": "c0070",
          "type": "say",
          "characterId": "post",
          "text": "Under the clock?"
        },
        {
          "id": "c0071",
          "type": "say",
          "text": "Twenty years he'd been delivering letters. He had never seen an address like it."
        },
        {
          "id": "c0072",
          "type": "say",
          "text": "The post office closed at half past six. It was his daughter's birthday; he'd promised to be home early."
        },
        {
          "id": "c0073",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "girlLeft",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0074",
              "type": "say",
              "text": "But when he reached the corner, there was nobody under the clock."
            },
            {
              "id": "c0075",
              "type": "choice",
              "options": [
                {
                  "id": "c0076",
                  "text": "Put the letter back in the bag and go home.",
                  "effects": [
                    {
                      "variableId": "letterGiven",
                      "op": "set",
                      "value": false
                    }
                  ]
                }
              ],
              "prompt": "There's nobody under the clock."
            },
            {
              "id": "c0077",
              "type": "say",
              "text": "The next day he took it back to the post office and ticked the box that said Undeliverable."
            },
            {
              "id": "c0078",
              "type": "say",
              "text": "In the photograph he's only a blur on a bicycle, passing."
            }
          ],
          "else": [
            {
              "id": "c0079",
              "type": "say",
              "text": "A girl in a long coat stood under the clock, her scarf pulled up to her chin. She kept looking up at the clock."
            },
            {
              "id": "c0080",
              "type": "choice",
              "options": [
                {
                  "id": "c0081",
                  "text": "Stop and give her the letter.",
                  "effects": [
                    {
                      "variableId": "letterGiven",
                      "op": "set",
                      "value": true
                    }
                  ]
                },
                {
                  "id": "c0082",
                  "text": "Go home. Deliver it tomorrow.",
                  "effects": [
                    {
                      "variableId": "letterGiven",
                      "op": "set",
                      "value": false
                    }
                  ]
                }
              ],
              "prompt": "Ten past six."
            },
            {
              "id": "c0083",
              "type": "if",
              "condition": {
                "kind": "compare",
                "variableId": "letterGiven",
                "op": "==",
                "value": true
              },
              "then": [
                {
                  "id": "c0084",
                  "type": "say",
                  "text": "He pulled over and took the letter out of his bag."
                },
                {
                  "id": "c0085",
                  "type": "say",
                  "characterId": "post",
                  "text": "Lin Xiu? This is for you."
                },
                {
                  "id": "c0086",
                  "type": "say",
                  "text": "The girl hesitated, then took it. She didn't open it straight away."
                },
                {
                  "id": "c0087",
                  "type": "say",
                  "text": "In the photograph his hand is still held out; the letter has only just left his fingers."
                }
              ],
              "else": [
                {
                  "id": "c0088",
                  "type": "say",
                  "text": "He rode past her and rang his bell once. She'll be here again tomorrow, he thought. People who wait in the street always come back."
                },
                {
                  "id": "c0089",
                  "type": "say",
                  "text": "In the photograph he's only a blur on a bicycle, passing."
                }
              ]
            }
          ]
        },
        {
          "id": "c0090",
          "type": "setVar",
          "effect": {
            "variableId": "seenPost",
            "op": "set",
            "value": true
          }
        },
        {
          "id": "c0091",
          "type": "jump",
          "targetSceneId": "photo"
        }
      ]
    },
    {
      "id": "girl1",
      "name": "Lin Xiu",
      "position": {
        "x": 600,
        "y": 220
      },
      "commands": [
        {
          "id": "c0092",
          "type": "bg",
          "background": {
            "kind": "image",
            "assetId": "bg_near_girl"
          },
          "transition": "fade"
        },
        {
          "id": "c0093",
          "type": "hide",
          "characterId": "boy"
        },
        {
          "id": "c0094",
          "type": "hide",
          "characterId": "post"
        },
        {
          "id": "c0095",
          "type": "hide",
          "characterId": "girl"
        },
        {
          "id": "c0096",
          "type": "say",
          "text": "6:00."
        },
        {
          "id": "c0097",
          "type": "say",
          "text": "Lin Xiu kept her hands in her coat pockets. In one of them was a ticket for the seven o'clock train."
        },
        {
          "id": "c0098",
          "type": "say",
          "text": "He had said: six o'clock, under the clock. I'll see you off."
        },
        {
          "id": "c0099",
          "type": "say",
          "text": "She had been standing here twenty minutes. The clock moved very slowly, and also very fast."
        },
        {
          "id": "c0100",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "letterGiven",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0101",
              "type": "say",
              "text": "A postman had just stopped and handed her a letter. There was only one line in it:"
            },
            {
              "id": "c0102",
              "type": "say",
              "text": "\"Don't wait for me. I'll be across the street, watching you go.\""
            },
            {
              "id": "c0103",
              "type": "say",
              "text": "She looked across the street. Too many people, and the lamps too bright. She couldn't make anyone out."
            }
          ],
          "else": [
            {
              "id": "c0104",
              "type": "if",
              "condition": {
                "kind": "compare",
                "variableId": "seenPost",
                "op": "==",
                "value": true
              },
              "then": [
                {
                  "id": "c0105",
                  "type": "say",
                  "text": "A postman rode past her, rang his bell once, and didn't stop."
                }
              ],
              "else": []
            },
            {
              "id": "c0106",
              "type": "say",
              "text": "She didn't know whether he'd come. She only knew the train wouldn't wait."
            }
          ]
        },
        {
          "id": "c0107",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "boyStayed",
            "op": "==",
            "value": true
          },
          "then": [
            {
              "id": "c0108",
              "type": "say",
              "text": "Not far off, a newspaper boy was calling: Evening paper! Evening paper! She thought: after tonight, I won't read this city's evening paper again."
            }
          ],
          "else": []
        },
        {
          "id": "c0109",
          "type": "choice",
          "options": [
            {
              "id": "c0110",
              "text": "Wait a little longer.",
              "effects": [
                {
                  "variableId": "girlLeft",
                  "op": "set",
                  "value": false
                }
              ]
            },
            {
              "id": "c0111",
              "text": "Turn around and go to the station.",
              "effects": [
                {
                  "variableId": "girlLeft",
                  "op": "set",
                  "value": true
                }
              ]
            }
          ],
          "prompt": "Twelve minutes past six."
        },
        {
          "id": "c0112",
          "type": "if",
          "condition": {
            "kind": "compare",
            "variableId": "girlLeft",
            "op": "==",
            "value": false
          },
          "then": [
            {
              "id": "c0113",
              "type": "say",
              "text": "She looked up at the clock once more."
            },
            {
              "id": "c0114",
              "type": "say",
              "text": "In the photograph her face is turned up, as if she were waiting for the clock to decide for her."
            }
          ],
          "else": [
            {
              "id": "c0115",
              "type": "say",
              "text": "She turned and walked towards the station. She was several steps away before she knew she wasn't going to look back."
            },
            {
              "id": "c0116",
              "type": "say",
              "text": "In the photograph she's almost out of the frame, just a blurred back."
            }
          ]
        },
        {
          "id": "c0117",
          "type": "setVar",
          "effect": {
            "variableId": "seenGirl",
            "op": "set",
            "value": true
          }
        },
        {
          "id": "c0118",
          "type": "jump",
          "targetSceneId": "photo"
        }
      ]
    },
