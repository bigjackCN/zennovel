{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game",
  "description": "What a game page may do: close its window and switch fullscreen.",
  "windows": ["main"],
  "remote": {
    "urls": ["game://*", "http://game.localhost/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
